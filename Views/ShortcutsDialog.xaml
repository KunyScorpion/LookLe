<Window x:Class="LeeyesViewer.Views.ShortcutsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定 ＆ ショートカット"
        Width="720" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="#1a1b20"
        Foreground="#f1f3f7"
        FontSize="13"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="#3a3e4b"
        BorderThickness="1">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#f1f3f7" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Behavior / Navigation Settings -->
            <RowDefinition Height="Auto" /> <!-- UI Scale / Font Size -->
            <RowDefinition Height="Auto" /> <!-- Cache Management -->
            <RowDefinition Height="*" />    <!-- Shortcuts Guide -->
            <RowDefinition Height="Auto" /> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚙ 設定 ＆ キーボードショートカット" FontSize="18" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center" />
            <Button Content="✕" DockPanel.Dock="Right" Width="32" Height="32" Background="Transparent" Foreground="#a0a6b5" BorderThickness="0" FontSize="15" Cursor="Hand" Click="Close_Click" HorizontalAlignment="Right" />
        </DockPanel>

        <!-- Behavior Settings Section -->
        <Border Grid.Row="1" Background="#23252c" BorderBrush="#2d3039" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="⚡ 動作・連続移動設定" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,10" />
                <CheckBox x:Name="ChkContinuousNav" Foreground="#f1f3f7" FontSize="13" VerticalAlignment="Center" Checked="ChkContinuousNav_Changed" Unchecked="ChkContinuousNav_Changed">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="最後のページ到達時に、自動で次のフォルダ・書庫へ移動する" Foreground="#f1f3f7" FontWeight="SemiBold" />
                        <TextBlock Text="※ オフの場合、最後のページ（または先頭ページ）で移動がストップします" Foreground="#a0a6b5" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- UI Scaling & Appearance Setting Section -->
        <Border Grid.Row="2" Background="#23252c" BorderBrush="#2d3039" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="🎛 UIフォント・全体スケール設定" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="UI全体スケール:" Foreground="#a0a6b5" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Slider Grid.Column="1" x:Name="SliderUiScale" Minimum="0.8" Maximum="1.3" SmallChange="0.05" LargeChange="0.1" Value="1.0" VerticalAlignment="Center" ValueChanged="SliderUiScale_ValueChanged" />
                    <TextBlock Grid.Column="2" x:Name="TxtUiScaleVal" Text="100%" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center" Margin="12,0,16,0" Width="45" />
                    <Button Grid.Column="3" Content="リセット" Background="#2a2d36" Foreground="#a0a6b5" BorderBrush="#3a3e4b" Padding="10,4" Cursor="Hand" Click="ResetScale_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Cache Management Section -->
        <Border Grid.Row="3" Background="#23252c" BorderBrush="#2d3039" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="💾 Leeyes ディスクサムネイルキャッシュ" FontWeight="Bold" Foreground="#38bdf8" />
                    <Button Content="更新" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="10,3" Background="#2a2d36" Foreground="#a0a6b5" BorderBrush="#3a3e4b" Cursor="Hand" Click="RefreshCache_Click" />
                </DockPanel>

                <TextBlock x:Name="TxtCacheDir" Text="保存先: 読込中..." Foreground="#a0a6b5" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="キャッシュ枚数: " Foreground="#a0a6b5" />
                        <TextBlock x:Name="TxtCacheCount" Text="0 枚" FontWeight="Bold" Foreground="#38bdf8" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="合計サイズ: " Foreground="#a0a6b5" />
                        <TextBlock x:Name="TxtCacheSize" Text="0 MB" FontWeight="Bold" Foreground="#38bdf8" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="BtnClearCache" Content="サムネイルキャッシュを消去" Background="#3b1d1d" Foreground="#f87171" BorderBrush="#7f1d1d" Padding="12,5" Cursor="Hand" Click="ClearCache_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Shortcuts Cheatsheet -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Group 1 -->
                <Border Background="#23252c" BorderBrush="#2d3039" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📖 ページ送り・移動 ＆ 見開き補正" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,8" />
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="← / Space / PageDown" Foreground="#e2e8f0" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="次のページへ進む (見開き時は2P送り)" Foreground="#a0a6b5"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="→ / Shift+Space / PageUp" Foreground="#e2e8f0" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="前のページへ戻る (見開き時は2P戻し)" Foreground="#a0a6b5"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="↑ (上キー)" Foreground="#38bdf8" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="【見開き補正】1ページ戻す (ずれ調整)" Foreground="#38bdf8" FontWeight="SemiBold"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="↓ (下キー)" Foreground="#38bdf8" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="【見開き補正】1ページ進める (ずれ調整)" Foreground="#38bdf8" FontWeight="SemiBold"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Home / End" Foreground="#e2e8f0" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="先頭ページ / 最終ページ" Foreground="#a0a6b5"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="] / [" Foreground="#e2e8f0" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="次の書庫・フォルダ / 前の書庫・フォルダ" Foreground="#a0a6b5"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="マウスホイール" Foreground="#e2e8f0" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="ページ送り (ズーム時はスクロール)" Foreground="#a0a6b5"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="画面左右クリック" Foreground="#e2e8f0" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="左:進む / 右:戻る" Foreground="#a0a6b5"/></Grid>
                    </StackPanel>
                </Border>

                <!-- Group 2 -->
                <Border Background="#23252c" BorderBrush="#2d3039" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🖼 表示・レイアウト設定" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,8" />
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="M" Foreground="#e2e8f0" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="単ページ / 見開き(右開き) / 見開き(左開き) 切替" Foreground="#a0a6b5"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="C" Foreground="#e2e8f0" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="1ページ目(表紙)の単独表示 ON/OFF" Foreground="#a0a6b5"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="O / Shift + C" Foreground="#e2e8f0" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="見開き位置を1ページずらす" Foreground="#a0a6b5"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="1 / 2 / 3 / 4" Foreground="#e2e8f0" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="全体表示 / 幅合わせ / 高さ合わせ / 原寸(1:1)" Foreground="#a0a6b5"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="F3" Foreground="#e2e8f0" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="下部サムネイル一覧の表示/非表示" Foreground="#a0a6b5"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="F4" Foreground="#e2e8f0" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="左サイドバーの表示/非表示" Foreground="#a0a6b5"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="F11 / Enter" Foreground="#e2e8f0" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="全画面表示の切替" Foreground="#a0a6b5"/></Grid>
                    </StackPanel>
                </Border>

                <!-- Group 3 -->
                <Border Background="#23252c" BorderBrush="#2d3039" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock Text="🔍 ズーム・回転 ＆ 反転操作" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,8" />
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Ctrl + ホイール" Foreground="#e2e8f0" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="スムーズズームイン / ズームアウト" Foreground="#a0a6b5"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="+ / -" Foreground="#e2e8f0" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="ズームイン / ズームアウト" Foreground="#a0a6b5"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="0 / Ctrl + 0" Foreground="#e2e8f0" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="ズームリセット (100%)" Foreground="#a0a6b5"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="R" Foreground="#38bdf8" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="右へ 90° 回転 (画像ごとの中心軸回転)" Foreground="#38bdf8" FontWeight="SemiBold"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="H" Foreground="#38bdf8" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="左右反転 (水平ミラー切替)" Foreground="#38bdf8" FontWeight="SemiBold"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="右ボタンドラッグ" Foreground="#e2e8f0" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="拡大時のスムーズ画像パン (移動)" Foreground="#a0a6b5"/></Grid>
                        <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="D&amp;D" Foreground="#e2e8f0" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="ZIP/CBZ・フォルダを画面へドロップして開く" Foreground="#a0a6b5"/></Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="5" Margin="0,16,0,0">
            <Button Content="閉じる (Esc)" DockPanel.Dock="Right" Background="#38bdf8" Foreground="#000" FontWeight="Bold" Padding="18,7" BorderThickness="0" Cursor="Hand" Click="Close_Click" HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</Window>

<Application x:Class="LeeyesViewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Global Colors & Brushes -->
        <Color x:Key="ColorBgPrimary">#121316</Color>
        <Color x:Key="ColorBgSecondary">#1a1b20</Color>
        <Color x:Key="ColorBgTertiary">#23252c</Color>
        <Color x:Key="ColorBgElevated">#2a2d36</Color>
        <Color x:Key="ColorBgHover">#323642</Color>
        <Color x:Key="ColorBorderSubtle">#2d3039</Color>
        <Color x:Key="ColorBorderMedium">#3a3e4b</Color>
        <Color x:Key="ColorAccent">#38bdf8</Color>
        <Color x:Key="ColorTextPrimary">#f1f3f7</Color>
        <Color x:Key="ColorTextSecondary">#a0a6b5</Color>
        <Color x:Key="ColorTextMuted">#6b7280</Color>

        <SolidColorBrush x:Key="BrushBgPrimary" Color="{StaticResource ColorBgPrimary}" />
        <SolidColorBrush x:Key="BrushBgSecondary" Color="{StaticResource ColorBgSecondary}" />
        <SolidColorBrush x:Key="BrushBgTertiary" Color="{StaticResource ColorBgTertiary}" />
        <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource ColorBgElevated}" />
        <SolidColorBrush x:Key="BrushBgHover" Color="{StaticResource ColorBgHover}" />
        <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}" />
        <SolidColorBrush x:Key="BrushBorderMedium" Color="{StaticResource ColorBorderMedium}" />
        <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
        <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
        <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    </Application.Resources>
</Application>
